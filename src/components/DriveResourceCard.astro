---
// src/components/DriveResourceCard.astro
interface Props {
  title: string;
  subtitle: string;
  size: string;
  url: string;
  icon?: 'drive' | 'canva' | 'code';
}

const { title, subtitle, size, url, icon = 'drive' } = Astro.props;
---

<div class="islp-resource-card">
  <div class="islp-resource-badge">{icon.toUpperCase()}</div>
  <div class="islp-resource-header">
    <div class="islp-resource-icon-wrap">
      {icon === 'canva' ? (
        <svg class="islp-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
      ) : icon === 'code' ? (
        <svg class="islp-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      ) : (
        <svg class="islp-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      )}
    </div>
    <div class="islp-resource-meta">
      <h4 class="islp-resource-title">{title}</h4>
      <p class="islp-resource-sub">{subtitle}</p>
    </div>
  </div>
  <div class="islp-resource-footer">
    <span class="islp-resource-tag">{size}</span>
    <a href={url} target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-primary islp-btn-sm">
      Abrir en {icon === 'canva' ? 'Canva' : 'Drive'}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>
</div>
