---
// src/pages/blog.astro
import Layout from '../layouts/Layout.astro';
import { getQuartoPage } from '../utils/quarto';

const pageData = getQuartoPage('blog');

// Clean relative links generated by Quarto listing so they point to Astro /posts/ routes
const cleanHtml = pageData.htmlContent
  .replace(/href=["'](?:\.\.\/)+content\/posts\/([^"']+)\.html["']/g, 'href="/posts/$1"')
  .replace(/href=["'](?:\.\.\/)+posts\/([^"']+)\.html["']/g, 'href="/posts/$1"')
  .replace(/href=["']posts\/([^"']+)\.html["']/g, 'href="/posts/$1"');
---

<Layout title={pageData.title} description={pageData.description} currentPath="/blog">
  <div class="islp-quarto-container">
    <div class="container">
      <div class="islp-injected-part" set:html={cleanHtml} />
    </div>
  </div>
</Layout>

<style>
  .islp-quarto-container {
    padding: 2.5rem 0 5rem;
  }
</style>
