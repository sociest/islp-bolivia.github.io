---
// src/pages/blog.astro
import Layout from '../layouts/Layout.astro';
import { getQuartoPage } from '../utils/quarto';

const pageData = getQuartoPage('blog');

// Clean relative links generated by Quarto listing so they point to Astro /posts/ routes
const cleanHtml = pageData.htmlContent
  .replace(/href=["'](?:\.\.\/)+content\/posts\/([^"']+)\.html["']/g, 'href="/posts/$1"')
  .replace(/href=["'](?:\.\.\/)+posts\/([^"']+)\.html["']/g, 'href="/posts/$1"')
  .replace(/href=["']posts\/([^"']+)\.html["']/g, 'href="/posts/$1"');
---

<Layout title={pageData.title} description={pageData.description} currentPath="/blog">
  <div class="islp-quarto-container">
    <div class="container">
      <!-- Interactive Blog Toolbar: Global Search & Section Category Filter -->
      <div class="islp-blog-toolbar">
        <div class="islp-global-search-box">
          <svg class="islp-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="islp-global-search"
            class="islp-global-input"
            placeholder="Buscar por palabra clave en convocatorias, normativas, boletines, casos de estudio..."
            autocomplete="off"
            aria-label="Buscar publicaciones"
          />
          <button type="button" id="islp-clear-search" class="islp-clear-btn" aria-label="Limpiar búsqueda" style="display: none;">
            ✕
          </button>
        </div>

        <div class="islp-category-pills" id="islp-category-pills" role="tablist" aria-label="Filtrar por sección">
          <button type="button" class="islp-pill active" data-section="all">Todas las Publicaciones</button>
          <button type="button" class="islp-pill" data-section="convocatorias">📢 Convocatorias</button>
          <button type="button" class="islp-pill" data-section="normativas">📋 Normativas</button>
          <button type="button" class="islp-pill" data-section="boletines">📰 Boletines</button>
          <button type="button" class="islp-pill" data-section="historico">🏛️ Archivo Histórico</button>
          <button type="button" class="islp-pill" data-section="casos-estudio">🏆 Casos de Estudio</button>
        </div>
      </div>

      <div class="islp-injected-part" set:html={cleanHtml} />
    </div>
  </div>
</Layout>

<script>
  function initListingsEngine() {
    const listings = Array.from(document.querySelectorAll<HTMLElement>('.quarto-listing'));
    if (!listings.length) return;

    (window as any)['quarto-listings'] = (window as any)['quarto-listings'] || {};

    // Helper to decode Quarto's base64 categories
    function decodeCategories(raw: string | null): string {
      if (!raw) return '';
      try {
        return decodeURIComponent(escape(atob(raw))).toLowerCase();
      } catch (_) {
        return raw.toLowerCase();
      }
    }

    // Individual listing handler
    listings.forEach(listingEl => {
      const listingId = listingEl.id;
      const tbody = listingEl.querySelector<HTMLTableSectionElement>('tbody.list');
      const searchInput = listingEl.querySelector<HTMLInputElement>('input.search');
      const sortSelect = listingEl.querySelector<HTMLSelectElement>('select.form-select');
      const sortHeaders = Array.from(listingEl.querySelectorAll<HTMLAnchorElement>('th a.sort'));

      if (!tbody) return;

      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));

      // Filter function for this listing
      const filterListing = (query: string): number => {
        const q = query.trim().toLowerCase();
        let visibleCount = 0;

        rows.forEach(row => {
          if (!q) {
            row.style.display = '';
            visibleCount++;
            return;
          }
          const text = (row.textContent || '').toLowerCase();
          const cats = decodeCategories(row.getAttribute('data-categories'));

          if (text.includes(q) || cats.includes(q)) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        // Manage no-results notice row
        let noResultsRow = tbody.querySelector<HTMLTableRowElement>('.islp-no-results');
        if (visibleCount === 0) {
          if (!noResultsRow) {
            noResultsRow = document.createElement('tr');
            noResultsRow.className = 'islp-no-results';
            noResultsRow.innerHTML = `<td colspan="3" style="text-align: center; padding: 2.25rem 1rem; color: #64748b; font-style: italic; background: #f8fafc;">No se encontraron publicaciones que coincidan con "${query}".</td>`;
            tbody.appendChild(noResultsRow);
          } else {
            noResultsRow.style.display = '';
            const td = noResultsRow.querySelector('td');
            if (td) td.textContent = `No se encontraron publicaciones que coincidan con "${query}".`;
          }
        } else if (noResultsRow) {
          noResultsRow.style.display = 'none';
        }

        return visibleCount;
      };

      // Sort function for this listing
      const sortListing = (sortKey: string, direction: 'asc' | 'desc') => {
        const currentRows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr:not(.islp-no-results)'));
        currentRows.sort((a, b) => {
          if (sortKey.includes('date')) {
            const dateA = Number(a.getAttribute('data-listing-date-sort')) || 0;
            const dateB = Number(b.getAttribute('data-listing-date-sort')) || 0;
            return direction === 'asc' ? dateA - dateB : dateB - dateA;
          }
          if (sortKey.includes('title')) {
            const titleA = (a.getAttribute('data-listing-title-sort') || a.querySelector('.listing-title')?.textContent || '').toLowerCase().trim();
            const titleB = (b.getAttribute('data-listing-title-sort') || b.querySelector('.listing-title')?.textContent || '').toLowerCase().trim();
            return direction === 'asc' ? titleA.localeCompare(titleB) : titleB.localeCompare(titleA);
          }
          return 0;
        });
        currentRows.forEach(r => tbody.appendChild(r));
      };

      // Register with Quarto window namespace so inline handlers work
      if (listingId) {
        (window as any)['quarto-listings'][listingId] = {
          sort: (key: string, opts?: { order?: 'asc' | 'desc' }) => {
            sortListing(key, opts?.order || 'asc');
          },
          search: (q: string) => {
            filterListing(q);
          }
        };
      }

      // Hook up input.search events
      if (searchInput) {
        searchInput.addEventListener('input', () => {
          filterListing(searchInput.value);
        });
        searchInput.addEventListener('search', () => {
          filterListing(searchInput.value);
        });
      }

      // Hook up select.form-select events
      if (sortSelect) {
        sortSelect.addEventListener('change', () => {
          const opt = sortSelect.options[sortSelect.selectedIndex];
          if (!opt || !opt.value) return;
          const sortKey = opt.value;
          const dir = (opt.getAttribute('data-direction') || 'asc') as 'asc' | 'desc';
          sortListing(sortKey, dir);
        });
      }

      // Hook up header column click sorting
      sortHeaders.forEach(thLink => {
        thLink.addEventListener('click', (e) => {
          e.preventDefault();
          const sortKey = thLink.getAttribute('data-sort') || 'listing-date-sort';
          const isAsc = thLink.classList.contains('sort-asc');
          sortHeaders.forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
          if (isAsc) {
            thLink.classList.add('sort-desc');
            sortListing(sortKey, 'desc');
          } else {
            thLink.classList.add('sort-asc');
            sortListing(sortKey, 'asc');
          }
        });
      });
    });

    // Global Search across all listings
    const globalSearchInput = document.getElementById('islp-global-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('islp-clear-search') as HTMLButtonElement | null;

    if (globalSearchInput) {
      const handleGlobalSearch = () => {
        const query = globalSearchInput.value;
        if (clearBtn) {
          clearBtn.style.display = query ? 'block' : 'none';
        }

        listings.forEach(listingEl => {
          const localInput = listingEl.querySelector<HTMLInputElement>('input.search');
          if (localInput) localInput.value = query;
          const listingId = listingEl.id;
          if ((window as any)['quarto-listings']?.[listingId]?.search) {
            (window as any)['quarto-listings'][listingId].search(query);
          }
        });
      };

      globalSearchInput.addEventListener('input', handleGlobalSearch);
      globalSearchInput.addEventListener('search', handleGlobalSearch);

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          globalSearchInput.value = '';
          handleGlobalSearch();
          globalSearchInput.focus();
        });
      }
    }

    // Category / Section Pill Filters
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.islp-pill'));

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        const target = pill.getAttribute('data-section') || 'all';

        listings.forEach(listingEl => {
          const sectionEl = listingEl.closest<HTMLElement>('section.level2') || listingEl;
          const listingId = listingEl.id; // e.g. "listing-casos-estudio"
          const matches = target === 'all' || listingId.includes(target);

          sectionEl.style.display = matches ? '' : 'none';
        });

        if (target !== 'all') {
          const targetListing = listings.find(l => l.id.includes(target));
          const targetSection = targetListing?.closest<HTMLElement>('section.level2');
          if (targetSection) {
            targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initListingsEngine);
  } else {
    initListingsEngine();
  }
</script>

<style>
  .islp-quarto-container {
    padding: 2.5rem 0 5rem;
  }
</style>
