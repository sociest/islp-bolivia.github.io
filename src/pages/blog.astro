---
// src/pages/blog.astro
import Layout from '../layouts/Layout.astro';
import { getQuartoPage } from '../utils/quarto';

const pageData = getQuartoPage('blog');
---

<Layout title={pageData.title} description={pageData.description} currentPath="/blog">
  <div class="islp-quarto-container">
    <div class="container">
      <div class="islp-injected-part" set:html={pageData.htmlContent} />
    </div>
  </div>
</Layout>

<style>
  .islp-quarto-container {
    padding: 2rem 0 4rem;
  }
</style>
