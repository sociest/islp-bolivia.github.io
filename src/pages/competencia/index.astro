---
// src/pages/competencia/index.astro
import Layout from '../../layouts/Layout.astro';
import Lema from '../../components/Lema.astro';
---

<Layout title="5ª Versión (2026-2027)" currentPath="/competencia">
  <div class="container" style="padding: 3.5rem 1.5rem;">
    <div style="max-width: 860px; margin: 0 auto;">
      <div style="background: #e0f2fe; color: #0369a1; display: inline-block; padding: 4px 12px; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; margin-bottom: 1rem;">
        Convocatoria Oficial
      </div>
      <h1 style="font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 1rem;">
        5ª Competencia Boliviana de Pósters Estadísticos (2026-2027)
      </h1>
      <p style="font-size: 1.15rem; color: var(--islp-text-secondary); line-height: 1.7; margin-bottom: 2rem;">
        El certamen nacional bienal coordinado por el <strong>International Statistical Literacy Project (ISLP)</strong>, el International Statistical Institute (ISI) y la International Association for Statistical Education (IASE).
      </p>

      <Lema
        quote="Aprender a formular preguntas con datos es una de las habilidades más poderosas del siglo XXI para la juventud boliviana."
        author="Dirección Nacional ISLP Bolivia"
      />

      <div style="background: var(--islp-surface); border: 1px solid var(--islp-border); border-radius: var(--radius-md); padding: 2.2rem; margin: 2.5rem 0; box-shadow: var(--shadow-sm);">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">🎯 Objetivos del Certamen</h2>
        <ul style="padding-left: 1.5rem; line-height: 1.8; color: var(--islp-text-primary); font-size: 1.05rem;">
          <li><strong>Fomentar el razonamiento cuantitativo:</strong> Recolectar datos reales, interpretar gráficos y extraer conclusiones basadas en evidencia empírica.</li>
          <li><strong>Impulsar el trabajo colaborativo:</strong> Formar brigadas de 2 a 5 estudiantes guiados activamente por un profesor o tutor.</li>
          <li><strong>Visibilizar el talento boliviano:</strong> Representar a Bolivia en la competencia internacional del ISLP ante más de 120 países.</li>
        </ul>
      </div>

      <div style="background: var(--islp-surface); border: 1px solid var(--islp-border); border-radius: var(--radius-md); padding: 2.2rem; margin: 2.5rem 0; box-shadow: var(--shadow-sm);">
        <h2 style="font-size: 1.5rem; margin-bottom: 1.2rem;">👥 ¿Quiénes pueden participar?</h2>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="border-bottom: 2px solid var(--islp-border); background: #f8fafc;">
                <th style="padding: 0.75rem 1rem;">Categoría</th>
                <th style="padding: 0.75rem 1rem;">Edades</th>
                <th style="padding: 0.75rem 1rem;">Nivel Educativo</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--islp-border);">
                <td style="padding: 0.75rem 1rem;"><strong style="color: #0284c7;">Laplace</strong></td>
                <td style="padding: 0.75rem 1rem;">9 a 11 años</td>
                <td style="padding: 0.75rem 1rem;">Primaria (nacidos en 2015 o posteriores)</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--islp-border);">
                <td style="padding: 0.75rem 1rem;"><strong style="color: #10b981;">Bernoulli</strong></td>
                <td style="padding: 0.75rem 1rem;">12 a 15 años</td>
                <td style="padding: 0.75rem 1rem;">Secundaria Básica (nacidos 2011-2014)</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--islp-border);">
                <td style="padding: 0.75rem 1rem;"><strong style="color: #ea580c;">Poisson</strong></td>
                <td style="padding: 0.75rem 1rem;">16 a 18 años</td>
                <td style="padding: 0.75rem 1rem;">Bachillerato (nacidos 2008-2010)</td>
              </tr>
              <tr>
                <td style="padding: 0.75rem 1rem;"><strong style="color: #6d28d9;">Gauss</strong></td>
                <td style="padding: 0.75rem 1rem;">Sin límite de edad</td>
                <td style="padding: 0.75rem 1rem;">Universitarios de Pregrado</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;">
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSc7rDxBwNfyn-kl7dL-n6cunoIeHJ2K8BwpLvJGb4jq_6uL0Q/viewform" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-primary">
          Ir al Formulario de Inscripción →
        </a>
        <a href="/competencia/bases" class="islp-btn islp-btn-outline">
          Leer Bases y Reglamento
        </a>
      </div>
    </div>
  </div>
</Layout>
