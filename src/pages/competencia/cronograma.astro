---
// src/pages/competencia/cronograma.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cronograma Oficial" currentPath="/competencia/cronograma">
  <div class="container" style="padding: 3.5rem 1.5rem;">
    <div style="max-width: 860px; margin: 0 auto;">
      <h1 style="font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 1rem;">
        Cronograma Oficial 2026-2027
      </h1>
      <p style="font-size: 1.15rem; color: var(--islp-text-secondary); line-height: 1.7; margin-bottom: 2.5rem;">
        Planifica el desarrollo de tu póster con las fechas e hitos de la 5ª versión nacional:
      </p>

      <div class="islp-timeline-table-wrap">
        <table class="islp-timeline-table">
          <thead>
            <tr>
              <th>Fase</th>
              <th>Periodo</th>
              <th>Hito / Actividad</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Fase 1</strong></td>
              <td>Octubre 2026</td>
              <td>Lanzamiento de la convocatoria nacional y apertura de herramientas.</td>
              <td><span class="islp-badge islp-badge-success">Vigente</span></td>
            </tr>
            <tr>
              <td><strong>Fase 2</strong></td>
              <td>Octubre 2026 — Febrero 2027</td>
              <td>Periodo de registro de brigadas y talleres de orientación para tutores.</td>
              <td><span class="islp-badge islp-badge-info">En curso</span></td>
            </tr>
            <tr>
              <td><strong>Fase 3</strong></td>
              <td>Marzo 2027</td>
              <td>Fecha límite para el envío del archivo digital del póster al jurado.</td>
              <td><span class="islp-badge islp-badge-warning">Próximo</span></td>
            </tr>
            <tr>
              <td><strong>Fase 4</strong></td>
              <td>Abril 2027</td>
              <td>Deliberación de la comisión científica y calificación de los 3 mejores por categoría.</td>
              <td><span class="islp-badge islp-badge-neutral">Programado</span></td>
            </tr>
            <tr>
              <td><strong>Fase 5</strong></td>
              <td>Mayo 2027</td>
              <td>Ceremonia de premiación nacional y nominación para el certamen mundial del ISLP.</td>
              <td><span class="islp-badge islp-badge-neutral">Programado</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div style="margin-top: 3rem; background: var(--islp-surface); border: 1px solid var(--islp-border); border-radius: var(--radius-md); padding: 2rem; box-shadow: var(--shadow-sm); text-align: center;">
        <h3 style="margin-bottom: 0.5rem;">¿Deseas organizar un taller de orientación en tu institución?</h3>
        <p style="color: var(--islp-text-secondary); max-width: 580px; margin: 0 auto 1.5rem;">
          La Dirección Nacional del ISLP Bolivia ofrece charlas y capacitaciones virtuales gratuitas a demanda para colegios y carreras universitarias.
        </p>
        <a href="/contacto" class="islp-btn islp-btn-primary">
          Contactar con la Coordinación →
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .islp-timeline-table-wrap {
    overflow-x: auto;
    background: var(--islp-surface);
    border: 1px solid var(--islp-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .islp-timeline-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .islp-timeline-table th,
  .islp-timeline-table td {
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--islp-border);
  }

  .islp-timeline-table th {
    background: #f8fafc;
    color: var(--islp-navy-950);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .islp-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .islp-badge-success { background: #dcfce7; color: #15803d; }
  .islp-badge-info { background: #e0f2fe; color: #0369a1; }
  .islp-badge-warning { background: #ffedd5; color: #c2410c; }
  .islp-badge-neutral { background: #f1f5f9; color: #64748b; }
</style>
