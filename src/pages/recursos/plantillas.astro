---
// src/pages/recursos/plantillas.astro
import Layout from '../../layouts/Layout.astro';
import DriveResourceCard from '../../components/DriveResourceCard.astro';
---

<Layout title="Plantillas Oficiales de Póster (A1)" currentPath="/recursos/plantillas">
  <section class="islp-hero" style="background: radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.15), transparent 60%), linear-gradient(135deg, #070f1e 0%, #0d1b2a 100%);">
    <div class="container">
      <span class="islp-badge islp-badge-gold">Formatos A1 Descargables</span>
      <h1 class="islp-title islp-title-lg" style="margin-top: 1rem;">
        Plantillas de Diseño para tu Póster
      </h1>
      <p class="islp-lead" style="max-width: 800px;">
        Descarga o edita directamente en la nube plantillas optimizadas para la medida oficial <strong>A1 (594 × 841 mm)</strong>. Configura tu flujo en Canva, PowerPoint, LaTeX o programas vectoriales sin costo alguno.
      </p>
    </div>
  </section>

  <section class="islp-section">
    <div class="container">
      
      <!-- Info banner -->
      <div class="islp-callout islp-callout-info" style="margin-bottom: 2.5rem;">
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <div>
            <h4 style="color: #f8fafc; font-weight: 700; margin-bottom: 0.25rem;">Almacenamiento Cloud Optimizado</h4>
            <p style="color: #94a3b8; font-size: 0.95rem; margin: 0; line-height: 1.6;">
              Todas las plantillas están sincronizadas en <strong>Google Drive Oficial</strong> y enlaces directos de <strong>Canva</strong>. Esto permite duplicar los diseños en tu propia cuenta sin descargar archivos pesados que saturen tu equipo.
            </p>
          </div>
        </div>
      </div>

      <!-- Canva section -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: #06b6d4;"></span>
          <h2 style="font-size: 1.5rem; font-weight: 700; color: #f8fafc; margin: 0;">Plantillas Editables en Canva (Enlace Directo)</h2>
        </div>
        <p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 1.5rem;">
          Solo haz clic en el enlace, pulsa <em>"Usar plantilla para un diseño nuevo"</em> y edita con tu equipo en tiempo real desde el navegador.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
          <DriveResourceCard 
            title="Plantilla Canva: Categoría Laplace"
            subtitle="Diseño lúdico y visual con secciones amplias para Primaria (9 a 11 años)."
            size="Cloud / A1"
            icon="canva"
            url="https://www.canva.com/design/play/laplace-template-placeholder"
          />
          <DriveResourceCard 
            title="Plantilla Canva: Categoría Bernoulli"
            subtitle="Estructura infográfica balanceada para Secundaria Inicial (12 a 15 años)."
            size="Cloud / A1"
            icon="canva"
            url="https://www.canva.com/design/play/bernoulli-template-placeholder"
          />
          <DriveResourceCard 
            title="Plantilla Canva: Categoría Poisson"
            subtitle="Diseño sobrio de alto contraste para Secundaria Superior (16 a 18 años)."
            size="Cloud / A1"
            icon="canva"
            url="https://www.canva.com/design/play/poisson-template-placeholder"
          />
          <DriveResourceCard 
            title="Plantilla Canva: Categoría Gauss"
            subtitle="Layout académico en 3 columnas para Universitarios y Posgrado."
            size="Cloud / A1"
            icon="canva"
            url="https://www.canva.com/design/play/gauss-template-placeholder"
          />
        </div>
      </div>

      <!-- Google Drive / Local Software section -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: #3b82f6;"></span>
          <h2 style="font-size: 1.5rem; font-weight: 700; color: #f8fafc; margin: 0;">Plantillas para PowerPoint y Software de Diseño (Drive)</h2>
        </div>
        <p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 1.5rem;">
          Archivos editables `.pptx`, `.svg`, `.psd` y `.tex` ya calibrados con márgenes de seguridad de 2.5 cm y resolución para impresión nítida.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
          <DriveResourceCard 
            title="PowerPoint A1 Vertical (.pptx)"
            subtitle="Plantilla lista con guías de alineación, fuentes universales y paleta oficial."
            size="2.4 MB · PPTX"
            icon="drive"
            url="https://drive.google.com/drive/folders/placeholder-islp-pptx-vertical"
          />
          <DriveResourceCard 
            title="PowerPoint A1 Horizontal (.pptx)"
            subtitle="Formato apaisado ideal para pósters con líneas de tiempo o diagramas anchos."
            size="2.6 MB · PPTX"
            icon="drive"
            url="https://drive.google.com/drive/folders/placeholder-islp-pptx-horizontal"
          />
          <DriveResourceCard 
            title="Plantilla Vectorial (.SVG / Inkscape)"
            subtitle="Base vectorial escalable compatible con Inkscape, Illustrator y CorelDraw."
            size="1.1 MB · SVG"
            icon="code"
            url="https://drive.google.com/drive/folders/placeholder-islp-vectorial"
          />
          <DriveResourceCard 
            title="Plantilla LaTeX BeamerPoster (.tex)"
            subtitle="Código fuente LaTeX con paquete beamerposter para la categoría Gauss."
            size="350 KB · ZIP"
            icon="code"
            url="https://drive.google.com/drive/folders/placeholder-islp-latex"
          />
        </div>
      </div>

      <!-- Technical rules table -->
      <div class="islp-card" style="margin-top: 2rem;">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #f8fafc; margin-bottom: 1.25rem;">
          Especificaciones Técnicas Obligatorias (Reglamento ISLP)
        </h3>
        
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.92rem; color: #cbd5e1;">
            <thead>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); text-align: left;">
                <th style="padding: 0.75rem 1rem; color: #f1f5f9; font-weight: 600;">Parámetro</th>
                <th style="padding: 0.75rem 1rem; color: #f1f5f9; font-weight: 600;">Requerimiento Oficial</th>
                <th style="padding: 0.75rem 1rem; color: #f1f5f9; font-weight: 600;">Nota del Jurado</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 0.75rem 1rem; font-weight: 600; color: #38bdf8;">Dimensiones</td>
                <td style="padding: 0.75rem 1rem;">A1 (594 × 841 mm)</td>
                <td style="padding: 0.75rem 1rem;">Una sola cara, vertical u horizontal. No se admiten dípticos.</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 0.75rem 1rem; font-weight: 600; color: #38bdf8;">Peso máximo archivo</td>
                <td style="padding: 0.75rem 1rem;">10.0 MB</td>
                <td style="padding: 0.75rem 1rem;">Comprimir imágenes a 150-300 DPI antes de exportar.</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 0.75rem 1rem; font-weight: 600; color: #38bdf8;">Formato de entrega</td>
                <td style="padding: 0.75rem 1rem;">PDF digital (High Quality Print)</td>
                <td style="padding: 0.75rem 1rem;">Asegurarse de que el texto no esté rasterizado como mapa de bits.</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 0.75rem 1rem; font-weight: 600; color: #38bdf8;">Anonimato</td>
                <td style="padding: 0.75rem 1rem;">Sin nombres de autores ni colegio</td>
                <td style="padding: 0.75rem 1rem; color: #f43f5e; font-weight: 600;">¡Causal de descalificación si se incluye en el póster!</td>
              </tr>
              <tr>
                <td style="padding: 0.75rem 1rem; font-weight: 600; color: #38bdf8;">Legibilidad mínima</td>
                <td style="padding: 0.75rem 1rem;">Legible a 2 metros de distancia</td>
                <td style="padding: 0.75rem 1rem;">Títulos &gt; 72pt, subtítulos &gt; 36pt, cuerpo &gt; 24pt en lienzo A1.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>
</Layout>
