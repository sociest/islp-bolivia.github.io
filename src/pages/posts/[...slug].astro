---
// src/pages/posts/[...slug].astro
import Layout from '../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

export async function getStaticPaths() {
  const postsDir = path.resolve(process.cwd(), '.quarto-build/content/posts');
  if (!fs.existsSync(postsDir)) return [];

  const files = fs.readdirSync(postsDir).filter(f => f.endsWith('.html'));
  const paths: any[] = [];

  for (const file of files) {
    const rawSlug = file.replace(/\.html$/, '');
    const html = fs.readFileSync(path.join(postsDir, file), 'utf8');

    // Extract main content
    const mainMatch = html.match(/<main[^>]*id="quarto-document-content"[^>]*>([\s\S]*?)<\/main>/i);
    let content = mainMatch ? mainMatch[1] : html;

    // Remove quarto title-block-header if present
    content = content.replace(/<header id="title-block-header"[\s\S]*?<\/header>/i, '');

    // Extract metadata
    const titleMatch = html.match(/<title>([\s\S]*?)<\/title>/i) || html.match(/<h1 class="title">([\s\S]*?)<\/h1>/i);
    const title = titleMatch ? titleMatch[1].replace(/–.*$/, '').replace(/<[^>]*>/g, '').trim() : 'Publicación ISLP';

    const descMatch = html.match(/<meta name="description" content="([^"]*)"/i);
    const description = descMatch ? descMatch[1] : '';

    // Route with clean slug: /posts/[rawSlug]
    paths.push({
      params: { slug: rawSlug },
      props: { title, description, content, slug: rawSlug }
    });

    // Route with .html: /posts/[rawSlug].html
    paths.push({
      params: { slug: `${rawSlug}.html` },
      props: { title, description, content, slug: rawSlug }
    });
  }

  return paths;
}

const { title, description, content, slug } = Astro.props;
---

<Layout title={title} description={description} currentPath="/blog">
  <div class="islp-quarto-container">
    <div class="container">
      <nav class="islp-post-breadcrumb" aria-label="Ruta de navegación">
        <a href="/blog" class="islp-back-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Volver a Publicaciones y Archivo Histórico
        </a>
      </nav>

      <article class="islp-post-wrapper">
        <header class="islp-post-header">
          <span class="islp-post-badge">Documento Oficial · ISLP Bolivia</span>
          <h1 class="islp-post-title">{title}</h1>
          {description && <p class="islp-post-desc">{description}</p>}
        </header>

        <div class="islp-injected-part islp-post-body" set:html={content} />
      </article>
    </div>
  </div>
</Layout>

<style>
  .islp-post-breadcrumb {
    margin-bottom: 2rem;
  }
  .islp-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--cbpe-blue-royal, #2e3193);
    font-size: 0.95rem;
    padding: 0.4rem 0.8rem;
    background: rgba(46, 49, 147, 0.06);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }
  .islp-back-link:hover {
    background: var(--cbpe-blue-royal);
    color: #ffffff !important;
    transform: translateX(-3px);
  }
  .islp-post-wrapper {
    background: #ffffff;
    border-radius: var(--radius-md);
    border: 1px solid var(--islp-border);
    box-shadow: 0 4px 24px rgba(19, 21, 74, 0.07);
    padding: 3rem 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .islp-post-wrapper {
      padding: 2rem 1.5rem;
    }
  }
  .islp-post-header {
    border-bottom: 2px solid var(--islp-border);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }
  .islp-post-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--cbpe-blue-royal);
    background: rgba(46, 49, 147, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }
  .islp-post-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--cbpe-blue-midnight);
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .islp-post-desc {
    font-size: 1.1rem;
    color: var(--islp-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .islp-post-body {
    font-size: 1.05rem;
    line-height: 1.8;
  }
</style>
