---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import CategoryFinder from '../components/CategoryFinder.astro';
import { getQuartoPage } from '../utils/quarto';

const pageData = getQuartoPage('index');

// Replace mount point comment with CategoryFinder placeholder or split content
const parts = pageData.htmlContent.split('<div id="islp-finder-mount">');
const hasMount = parts.length > 1;
---

<Layout title={pageData.title} description={pageData.description} currentPath="/">
  <div class="islp-quarto-container">
    <div class="container">
      {hasMount ? (
        <>
          <div class="islp-injected-part" set:html={parts[0]} />
          <div class="islp-island-mount">
            <CategoryFinder />
          </div>
          <div class="islp-injected-part" set:html={parts[1].replace(/<\/div>/, '')} />
        </>
      ) : (
        <div class="islp-injected-part" set:html={pageData.htmlContent} />
      )}
    </div>
  </div>
</Layout>

<style>
  .islp-quarto-container {
    padding: 2rem 0 4rem;
  }
  .islp-island-mount {
    margin: 1.5rem 0 2.5rem;
  }
</style>
