---
// src/pages/boletines/index.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Boletines y Documentación Oficial" currentPath="/boletines">
  <!-- Hero Section -->
  <section class="islp-hero" style="background: radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.15), transparent 60%), linear-gradient(135deg, #070f1e 0%, #0d1b2a 100%);">
    <div class="container">
      <span class="islp-badge islp-badge-gold">Publicaciones Oficiales</span>
      <h1 class="islp-title islp-title-lg" style="margin-top: 1rem;">
        Boletines y Archivo Histórico ISLP
      </h1>
      <p class="islp-lead" style="max-width: 800px;">
        Descarga las publicaciones periódicas, normas de participación vigentes, memorias de clausura y documentos oficiales del Proyecto Internacional de Alfabetización Estadística en Bolivia.
      </p>
    </div>
  </section>

  <!-- Publicaciones Actuales -->
  <section class="islp-section">
    <div class="container">
      <div style="margin-bottom: 2.5rem;">
        <span class="islp-badge islp-badge-gold">Vigente 2026-2027</span>
        <h2 style="font-size: 1.65rem; font-weight: 700; color: #f8fafc; margin-top: 0.5rem; margin-bottom: 0.5rem;">
          Documentación Oficial de la 5ª Versión
        </h2>
        <p style="color: #94a3b8; font-size: 0.95rem;">
          Descarga los archivos rectores aprobados por la UMSA, Fundación ARU y el International Statistical Institute.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 3.5rem;">
        
        <div class="islp-card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span class="islp-badge islp-badge-gold" style="margin-bottom: 1rem;">Reglamento</span>
            <h3 style="font-size: 1.2rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem;">Normas de Participación 2026-2027</h3>
            <p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.25rem;">
              Bases completas, categorías de edad, composición de equipos con tutores y especificaciones de entrega.
            </p>
          </div>
          <a href="/img/Normas_de_participacion.pdf" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-primary islp-btn-sm" style="width: 100%;">
            Descargar PDF (Oficial) ↓
          </a>
        </div>

        <div class="islp-card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span class="islp-badge islp-badge-gold" style="margin-bottom: 1rem;">Metodología</span>
            <h3 style="font-size: 1.2rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem;">Guía de Elaboración de Pósters</h3>
            <p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.25rem;">
              Paso a paso para plantear preguntas de investigación, seleccionar gráficos, ordenar secciones y citar datos.
            </p>
          </div>
          <a href="/img/guia_2022_2023.pdf" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-primary islp-btn-sm" style="width: 100%;">
            Descargar Guía PDF ↓
          </a>
        </div>

        <div class="islp-card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span class="islp-badge islp-badge-gold" style="margin-bottom: 1rem;">Convocatoria</span>
            <h3 style="font-size: 1.2rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem;">Afiche Oficial de Convocatoria</h3>
            <p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.25rem;">
              Cartel imprimible de difusión escolar y universitaria para publicar en carteleras de colegios y facultades.
            </p>
          </div>
          <a href="/img/afiche2022.pdf" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-primary islp-btn-sm" style="width: 100%;">
            Descargar Afiche PDF ↓
          </a>
        </div>

        <div class="islp-card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span class="islp-badge islp-badge-gold" style="margin-bottom: 1rem;">Incentivos</span>
            <h3 style="font-size: 1.2rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem;">Cartilla de Premios y Reconocimientos</h3>
            <p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.25rem;">
              Premios institucionales, medallas de honor, diplomas con aval internacional y pase al Mundial ISLP.
            </p>
          </div>
          <a href="/img/Premios.pdf" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-primary islp-btn-sm" style="width: 100%;">
            Descargar Premios PDF ↓
          </a>
        </div>

      </div>

      <!-- Hemeroteca de Boletines Periódicos -->
      <div style="margin-bottom: 2rem;">
        <span class="islp-badge islp-badge-gold">Archivo de Publicaciones</span>
        <h2 style="font-size: 1.65rem; font-weight: 700; color: #f8fafc; margin-top: 0.5rem; margin-bottom: 0.5rem;">
          Boletines Informativos ISLP Bolivia
        </h2>
        <p style="color: #94a3b8; font-size: 0.95rem;">
          Revistas impresas y digitales con entrevistas a jurados, estadísticas de participación por departamento y crónicas de premiaciones.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        
        <div class="islp-card" style="background: rgba(13, 27, 42, 0.4);">
          <div style="font-size: 0.85rem; color: #38bdf8; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">Boletín Nº 1</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem;">Lanzamiento y Talleres Nacionales</h3>
          <p style="color: #94a3b8; font-size: 0.88rem; line-height: 1.6; margin-bottom: 1.25rem;">
            Capacitación a docentes de matemáticas de primaria y secundaria en visualización de datos y diseño infográfico.
          </p>
          <a href="/img/boletin_1.pdf" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-outline islp-btn-sm" style="width: 100%;">
            Leer Boletín Nº 1 (PDF) ↗
          </a>
        </div>

        <div class="islp-card" style="background: rgba(13, 27, 42, 0.4);">
          <div style="font-size: 0.85rem; color: #38bdf8; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">Boletín Nº 2</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem;">Evaluación Regional de Trabajos</h3>
          <p style="color: #94a3b8; font-size: 0.88rem; line-height: 1.6; margin-bottom: 1.25rem;">
            Crónica de deliberación del Comité Evaluador, análisis de las temáticas más recurrentes y retroalimentación metodológica.
          </p>
          <a href="/img/poster/ISLP_Bolivia _B2.pdf" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-outline islp-btn-sm" style="width: 100%;">
            Leer Boletín Nº 2 (PDF) ↗
          </a>
        </div>

        <div class="islp-card" style="background: rgba(13, 27, 42, 0.4);">
          <div style="font-size: 0.85rem; color: #38bdf8; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">Boletín Nº 3</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem;">Gala de Ganadores Nacionales</h3>
          <p style="color: #94a3b8; font-size: 0.88rem; line-height: 1.6; margin-bottom: 1.25rem;">
            Presentación de los pósters ganadores en Laplace, Bernoulli, Poisson y Gauss, clasificados al torneo mundial.
          </p>
          <a href="/img/poster/ISLP_Bolivia_B3.pdf" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-outline islp-btn-sm" style="width: 100%;">
            Leer Boletín Nº 3 (PDF) ↗
          </a>
        </div>

        <div class="islp-card" style="background: rgba(13, 27, 42, 0.4);">
          <div style="font-size: 0.85rem; color: #38bdf8; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">Memoria Final</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.5rem;">Clausura y Premiación Oficial</h3>
          <p style="color: #94a3b8; font-size: 0.88rem; line-height: 1.6; margin-bottom: 1.25rem;">
            Acta de premiación, estadísticas de impacto escolar y reconocimientos académicos otorgados por ARU y UMSA.
          </p>
          <a href="/img/poster/ISLP_Bolivia_clausura.pdf" target="_blank" rel="noopener noreferrer" class="islp-btn islp-btn-outline islp-btn-sm" style="width: 100%;">
            Leer Memoria (PDF) ↗
          </a>
        </div>

      </div>

    </div>
  </section>
</Layout>
